# Used by `docker compose` (Compose auto-loads this file as .env).
# Copy to .env and fill in. Get a free key at https://aistudio.google.com/apikey
# Leave blank to run in demo mode (UI works; search is not semantically meaningful).
GEMINI_API_KEY=

# --- Optional overrides ---
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DIM=1536
# Host ports (change if 8080/8000 are already in use on your machine)
# FRONTEND_PORT=8080
# BACKEND_PORT=8000
