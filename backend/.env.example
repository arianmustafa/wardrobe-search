# Google AI Studio API key — get a free one at https://aistudio.google.com/apikey
# Without this, the app runs in DEMO mode with deterministic fake embeddings
# (the UI works, but search results are not semantically meaningful).
GEMINI_API_KEY=

# --- Optional overrides (defaults shown) ---
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DIM=1536
# DEFAULT_TOP_N=12
# MAX_IMAGE_EDGE=1024
